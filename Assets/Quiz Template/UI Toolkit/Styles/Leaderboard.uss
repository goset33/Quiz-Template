.user-position-background {
    height: 45%;
    border-top-width: 7px;
    border-right-width: 7px;
    border-bottom-width: 7px;
    border-left-width: 7px;
    border-top-left-radius: 42px;
    border-top-right-radius: 42px;
    border-bottom-right-radius: 42px;
    border-bottom-left-radius: 42px;
    border-left-color: rgb(231, 247, 243);
    border-right-color: rgb(231, 247, 243);
    border-top-color: rgb(231, 247, 243);
    border-bottom-color: rgb(231, 247, 243);
    padding-bottom: 0;
    background-color: rgba(84, 84, 84, 0.53);
}

.separator {
    flex-grow: 0;
    width: 90%;
    height: 2%;
    background-color: rgba(101, 101, 101, 0);
    align-self: center;
    background-image: url("project://database/Assets/Quiz%20Template/Images/button.png?fileID=21300000&guid=9d241c14e7dc5774a99c5f73ad07bf3b&type=3#button");
    -unity-slice-scale: 1.5px;
    -unity-background-image-tint-color: rgba(101, 101, 101, 0.27);
    margin-top: 2%;
    margin-bottom: 2%;
}

.card-separator {
    flex-grow: 1;
    width: 1%;
    height: 60%;
    align-self: center;
    align-items: center;
    background-color: rgba(84, 84, 84, 0.53);
    border-top-left-radius: 180px;
    border-top-right-radius: 180px;
    border-bottom-right-radius: 180px;
    border-bottom-left-radius: 180px;
}

.card-background {
    width: 100%;
    flex-direction: row;
    padding-top: 3%;
    padding-right: 3%;
    padding-bottom: 3%;
    padding-left: 3%;
    justify-content: space-between;
    border-top-left-radius: 81px;
    border-top-right-radius: 81px;
    border-bottom-right-radius: 81px;
    border-bottom-left-radius: 81px;
    background-color: rgba(0, 0, 0, 0.04);
    flex-grow: 1;
    height: 100%;
    margin-top: 1%;
    margin-right: 1%;
    margin-bottom: 1%;
    margin-left: 1%;
    flex-shrink: 1;
    align-items: center;
    align-self: center;
}

.card-background--transparent {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
}

.position-background {
    flex-grow: 0;
    height: 85%;
    width: 20%;
    background-image: url("project://database/Assets/Quiz%20Template/Images/button.png?fileID=21300000&guid=9d241c14e7dc5774a99c5f73ad07bf3b&type=3#button");
    -unity-slice-scale: 4.6px;
    align-self: center;
    align-items: center;
    -unity-background-image-tint-color: rgb(214, 241, 248);
    aspect-ratio: 1;
    margin-top: 0%;
    margin-right: 2.5%;
    margin-bottom: 0%;
    margin-left: 2.5%;
    justify-content: center;
}

.position-text {
    flex-shrink: 1;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    -unity-text-auto-size: best-fit 10px 154px;
    padding-top: 20%;
    padding-right: 20%;
    padding-bottom: 20%;
    padding-left: 20%;
}

.position-text--big {
    align-self: center;
    padding-top: 2%;
    padding-right: 2%;
    padding-bottom: 10%;
    padding-left: 2%;
    border-top-width: 15px;
}

.unity-collection-view__item {
    margin-bottom: 2%;
}

.unity-list-view__item:hover {
    background-color: transparent;
}

.unity-list-view__item:selected {
    background-color: transparent;
}

.unity-scroller .unity-base-slider__tracker {
    background-color: rgba(147, 147, 147, 0);
    background-image: url("project://database/Assets/Quiz%20Template/Images/button.png?fileID=21300000&guid=9d241c14e7dc5774a99c5f73ad07bf3b&type=3#button");
    -unity-background-image-tint-color: rgb(204, 204, 204);
    -unity-slice-scale: 1px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.unity-base-slider__dragger {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Quiz%20Template/Images/button.png?fileID=21300000&guid=9d241c14e7dc5774a99c5f73ad07bf3b&type=3#button");
    -unity-slice-scale: 0.46px;
    width: 70%;
    top: auto;
    left: auto;
    right: auto;
    bottom: auto;
    margin-left: 13%;
    margin-right: 0%;
    margin-top: 0%;
    margin-bottom: 0%;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
