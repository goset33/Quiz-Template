<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Quiz%20Template/UI%20Toolkit/Styles/BaseUSS.uss?fileID=7433441132597879392&amp;guid=0d44cfccb0178034ebdbe525647efc14&amp;type=3#BaseUSS"/>
    <Style src="project://database/Assets/Quiz%20Template/UI%20Toolkit/Styles/Rewards.uss?fileID=7433441132597879392&amp;guid=0551b62b9cacb3147843e69a310bd3c1&amp;type=3#Rewards"/>
    <ui:VisualElement class="background" style="flex-grow: 1;">
        <ui:VisualElement name="TopZone" style="flex-grow: 0; height: 10%;">
            <ui:Label text="&#1058;&#1099; &#1087;&#1086;&#1073;&#1077;&#1076;&#1080;&#1083;!" name="HeaderText" class="dynamic-text" style="width: 100%; height: 100%; -unity-font-style: bold; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5%; padding-right: 35%; padding-bottom: 5%; padding-left: 35%;"/>
        </ui:VisualElement>
        <ui:VisualElement name="HeaderZone" style="flex-grow: 0; height: 30%;">
            <ui:Label text="&#1058;&#1099; &#1087;&#1088;&#1072;&#1074;&#1080;&#1083;&#1100;&#1085;&#1086; &#1086;&#1090;&#1074;&#1077;&#1090;&#1080;&#1083; &#1085;&#1072; -1 &#1074;&#1086;&#1087;&#1088;&#1086;&#1089;&#1086;&#1074; &#1080;&#1079; 10!" name="MainText" class="dynamic-text" style="width: 100%; height: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-font-style: bold; white-space: normal; color: rgb(46, 58, 69);"/>
        </ui:VisualElement>
        <ui:VisualElement name="MainZone" style="flex-grow: 0; height: 45%; align-items: center;">
            <ui:VisualElement name="RewardsContainer" style="flex-grow: 0; width: 50%; height: 50%; justify-content: space-between; align-items: center; margin-bottom: 5%;">
                <GradientElement gradient-from="rgb(255, 253, 229)" gradient-to="rgb(255, 247, 205)" name="StarReward" class="reward-background">
                    <ui:Image name="StarImage" style="aspect-ratio: 1; height: 100%;">
                        <Bindings>
                            <ui:DataBinding property="style.backgroundImage" data-source-path="cashSprite" data-source="project://database/Assets/Quiz%20Template/Example/Configs/Example%20Game%20Config.asset?fileID=11400000&amp;guid=feba4a2cb93aebc4aa364cd5364e340e&amp;type=2#Example Game Config" binding-mode="ToTarget"/>
                        </Bindings>
                    </ui:Image>
                    <ui:Label text="+2" name="StarText" class="dynamic-text" style="height: 100%; -unity-text-align: middle-left; white-space: nowrap; -unity-font-style: bold; color: rgb(46, 58, 69);"/>
                </GradientElement>
                <GradientElement gradient-from="rgb(255, 253, 229)" gradient-to="rgb(255, 247, 205)" name="ExpReward" class="reward-background">
                    <ui:Image name="ExpImage" style="aspect-ratio: 1; height: 100%; background-size: 80% 80%;">
                        <Bindings>
                            <ui:DataBinding property="style.backgroundImage" data-source-path="expSprite" data-source="project://database/Assets/Quiz%20Template/Example/Configs/Example%20Game%20Config.asset?fileID=11400000&amp;guid=feba4a2cb93aebc4aa364cd5364e340e&amp;type=2#Example Game Config" binding-mode="ToTarget"/>
                        </Bindings>
                    </ui:Image>
                    <ui:Label text="+233" name="ExpText" class="dynamic-text" style="height: 100%; width: 60%; max-width: 60%; -unity-text-align: middle-left; white-space: nowrap; -unity-font-style: bold; color: rgb(46, 58, 69);"/>
                </GradientElement>
            </ui:VisualElement>
            <ui:VisualElement name="ButtonsContainer" style="flex-grow: 0; width: 80%; height: 70%; align-items: center;">
                <GradientButton gradient-direction="Vertical" double-click-selects-word="false" triple-click-selects-line="false" gradient-from="rgb(0, 119, 194)" gradient-to="rgb(0, 87, 142)" name="DoubleButton" class="dynamic-text button" style="height: 45%; margin-bottom: 5%; width: 100%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 59px; border-top-right-radius: 59px; border-bottom-right-radius: 59px; border-bottom-left-radius: 59px; -unity-background-image-tint-color: rgb(255, 255, 255); padding-right: 6%; padding-left: 6%; padding-bottom: 2%; padding-top: 2%; align-items: center; flex-direction: row; color: rgb(255, 255, 255); -unity-font-style: bold; justify-content: space-between;">
                    <ui:Label text="Label" double-click-selects-word="false" triple-click-selects-line="false" name="DoubleText" style="height: 100%; width: 75%;">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:a2b025560d9220e4f8f138865dba18d1" entry="Id(119809467757842432)"/>
                        </Bindings>
                    </ui:Label>
                    <ui:VisualElement name="DoubleLabel" class="double-reward">
                        <ui:Label text="x2" double-click-selects-word="false" triple-click-selects-line="false" class="dynamic-text" style="flex-grow: 1; flex-shrink: 1; height: 100%; width: 100%; -unity-font-style: bold; color: rgb(255, 255, 255); padding-top: 15%; padding-right: 15%; padding-bottom: 15%; padding-left: 15%;"/>
                    </ui:VisualElement>
                </GradientButton>
                <ui:Button text="Button" double-click-selects-word="false" triple-click-selects-line="false" name="Back" focusable="false" class="dynamic-text button" style="height: 45%; width: 100%; -unity-slice-scale: 2.7px; background-color: rgba(255, 255, 255, 0.5); border-top-width: 8px; border-right-width: 8px; border-bottom-width: 8px; border-left-width: 8px; border-top-left-radius: 44px; border-top-right-radius: 44px; border-bottom-right-radius: 44px; border-bottom-left-radius: 44px; -unity-text-align: middle-center; color: rgb(0, 119, 194); -unity-font-style: bold;">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:a2b025560d9220e4f8f138865dba18d1" entry="Id(318117259071488)"/>
                    </Bindings>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
