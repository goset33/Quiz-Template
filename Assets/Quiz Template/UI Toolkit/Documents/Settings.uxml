<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Quiz%20Template/UI%20Toolkit/Styles/BaseUSS.uss?fileID=7433441132597879392&amp;guid=0d44cfccb0178034ebdbe525647efc14&amp;type=3#BaseUSS"/>
    <ui:VisualElement class="background" style="flex-grow: 1;">
        <ui:VisualElement name="TopZone" style="width: 100%; height: 10%; margin-bottom: 1%; flex-direction: row; flex-wrap: nowrap; justify-content: space-between; align-items: stretch;">
            <ui:Button name="Back" enabled="true" class="back-in-menu-button" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
            <LocalizedLabel localization-key="SETTINGS" display-tooltip-when-elided="true" class="dynamic-text" style="-unity-font-style: bold; margin-right: 25%; margin-left: 0%; margin-top: 0; margin-bottom: 0; padding-left: 2px; align-self: center; width: 50%; height: 80%; -unity-text-align: upper-center;"/>
        </ui:VisualElement>
        <ui:VisualElement name="MainZone" style="flex-grow: 1;"/>
    </ui:VisualElement>
</ui:UXML>
