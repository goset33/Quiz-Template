<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Quiz%20Template/UI%20Toolkit/Styles/BaseUSS.uss?fileID=7433441132597879392&amp;guid=0d44cfccb0178034ebdbe525647efc14&amp;type=3#BaseUSS"/>
    <Style src="project://database/Assets/Quiz%20Template/UI%20Toolkit/Styles/Main%20Menu.uss?fileID=7433441132597879392&amp;guid=68c57bea38ce18241b666562c7833b86&amp;type=3#Main Menu"/>
    <ui:VisualElement name="MainContainer" class="background">
        <ui:VisualElement name="LogoZone" style="width: 100%; height: 38%; margin-bottom: 1%; margin-top: 10%;">
            <ui:VisualElement name="LogoContainer" class="logo-container">
                <LocalizedImage localization-key="LOGO"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="CenterZone" style="height: 60%;">
            <ui:VisualElement name="ButtonContainer" class="button-container">
                <LocalizedButton localization-key="START_GAME" name="PlayButton" class="button-primary dynamic-text" style="height: 40%; white-space: pre-wrap;"/>
                <LocalizedButton localization-key="SETTINGS" name="SettingsButton" class="button-secondary dynamic-text"/>
                <LocalizedButton localization-key="LEADERBOARDS" name="LeaderboardButton" class="button-secondary dynamic-text"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
