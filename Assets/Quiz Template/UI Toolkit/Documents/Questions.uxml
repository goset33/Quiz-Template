<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Quiz%20Template/UI%20Toolkit/Styles/BaseUSS.uss?fileID=7433441132597879392&amp;guid=0d44cfccb0178034ebdbe525647efc14&amp;type=3#BaseUSS"/>
    <Style src="project://database/Assets/Quiz%20Template/UI%20Toolkit/Styles/Questions.uss?fileID=7433441132597879392&amp;guid=b3d3a0e1ee79b3248b0ef48b49711dd5&amp;type=3#Questions"/>
    <ui:VisualElement class="background" style="flex-grow: 1;">
        <ui:VisualElement name="TopZone" style="flex-grow: 0; width: 100%; height: 7%; flex-direction: row; align-items: center; justify-content: space-between; margin-top: 1%;">
            <ui:Button name="Back" class="back-in-menu-button" style="height: 100%;"/>
            <ui:VisualElement style="flex-grow: 0; width: 20%; height: 70%; background-image: url(&quot;project://database/Assets/Quiz%20Template/Images/button.png?fileID=21300000&amp;guid=9d241c14e7dc5774a99c5f73ad07bf3b&amp;type=3#button&quot;); -unity-slice-scale: 2px;">
                <ui:Label text="00:00" double-click-selects-word="false" triple-click-selects-line="false" name="TimeText" class="dynamic-text" style="-unity-font-style: bold; -unity-text-align: middle-center; flex-grow: 1; flex-shrink: 1; padding-top: 5%; padding-right: 5%; padding-bottom: 5%; padding-left: 5%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-auto-size: best-fit 10px 100px; font-size: 50%;"/>
            </ui:VisualElement>
            <ui:Button name="Hint" class="hint-button" style="height: 100%;"/>
        </ui:VisualElement>
        <ui:VisualElement name="UpperZone" style="flex-grow: 0; width: 100%; height: 35%; align-items: center;">
            <ui:VisualElement name="HeartContainer" style="flex-grow: 0; flex-direction: row; align-items: center; justify-content: space-evenly; width: 35%; align-self: center; height: 12%; margin-bottom: 1%;">
                <ui:Image name="Heart" class="heart"/>
                <ui:Image name="Heart" class="heart"/>
                <ui:Image name="Heart" class="heart"/>
            </ui:VisualElement>
            <ui:VisualElement name="DifficultBackground" style="flex-grow: 0; width: auto; height: 13%; background-image: url(&quot;project://database/Assets/Quiz%20Template/Images/button.png?fileID=21300000&amp;guid=9d241c14e7dc5774a99c5f73ad07bf3b&amp;type=3#button&quot;); -unity-slice-scale: 2px; margin-bottom: 2%; min-width: 30%; max-width: 50%;">
                <ui:Label text="&#1041;&#1054;&#1057;&#1057;-&#1042;&#1054;&#1055;&#1056;&#1054;&#1057;" name="DifficultText" class="dynamic-text" style="flex-grow: 1; flex-shrink: 1; -unity-text-align: middle-center; padding-top: 2%; padding-right: 4%; padding-bottom: 2%; padding-left: 4%; -unity-font-style: bold; font-size: 45%; color: rgb(255, 255, 255);"/>
            </ui:VisualElement>
            <ui:VisualElement name="QuestionContainer" style="flex-grow: 0; width: 80%; align-items: center; flex-direction: row; max-height: 70%;">
                <ui:VisualElement name="QuestionBackground" class="question-background">
                    <ui:Label text="fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" name="QuestionText" double-click-selects-word="false" triple-click-selects-line="false" class="dynamic-text" style="padding-top: 2%; padding-right: 2%; padding-left: 2%; padding-bottom: 2%; -unity-font-style: bold; -unity-text-align: middle-left; white-space: normal; -unity-text-auto-size: best-fit 25px 102px; height: 100%;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ButtonsZone" style="width: 100%; height: 40%; align-items: center;">
            <ui:VisualElement name="ButtonContainer" class="button-container">
                <GradientButton name="VariantButton" text="Answer" double-click-selects-word="false" triple-click-selects-line="false" class="dynamic-text variant-button"/>
            </ui:VisualElement>
            <ui:VisualElement name="ButtonContainer" class="button-container">
                <GradientButton name="VariantButton" text="Answer" double-click-selects-word="false" triple-click-selects-line="false" class="dynamic-text variant-button"/>
            </ui:VisualElement>
            <ui:VisualElement name="ButtonContainer" class="button-container">
                <GradientButton name="VariantButton" text="Answer" double-click-selects-word="false" triple-click-selects-line="false" class="dynamic-text variant-button"/>
            </ui:VisualElement>
            <ui:VisualElement name="ButtonContainer" class="button-container">
                <GradientButton name="VariantButton" text="Answer" double-click-selects-word="false" triple-click-selects-line="false" class="dynamic-text variant-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="FooterZone" style="flex-grow: 0; height: 10%; width: 100%; flex-direction: row; align-items: center; padding-top: 2%; padding-right: 5%; padding-bottom: 2%; padding-left: 5%; justify-content: center; margin-top: 1%;">
            <ui:Button text="Button" double-click-selects-word="false" triple-click-selects-line="false" focusable="false" name="ShowRightButton" class="dynamic-text show-answer-button">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:a2b025560d9220e4f8f138865dba18d1" entry="Id(114085047709945856)"/>
                </Bindings>
            </ui:Button>
            <GradientButton text="Next" gradient-direction="Vertical" gradient-to="rgb(0, 87, 142)" gradient-from="rgb(0, 119, 194)" name="NextButton" double-click-selects-word="false" triple-click-selects-line="false" class="dynamic-text next-button">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:a2b025560d9220e4f8f138865dba18d1" entry="Id(114076840618840064)"/>
                </Bindings>
            </GradientButton>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
